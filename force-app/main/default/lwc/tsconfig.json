{
  "compilerOptions": {
    "experimentalDecorators": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "useDefineForClassFields": false,
    "types": ["@salesforce/lightning-types"]
  },
  "include": [
    "**/*.ts",
    "../../../../.sfdx/typings/lwc/**/*.d.ts",
    "../../../../types/salesforce.d.ts",
    "../../../../node_modules/@salesforce/lightning-types/dist/**/*.d.ts"
  ],
  "exclude": [
    "**/__tests__/**"
  ]
}
